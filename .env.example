# Copy to .env.local (git-ignored) and fill in. Used only by the server route
# /api/ai-call; never sent to the browser. On Vercel, set these under
# Project -> Settings -> Environment Variables instead.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model (default gemini-3.8-flash).
GEMINI_MODEL=
